<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.idemilagrescript.MainController"
            stylesheets="@/application.css">
    <top>
        <VBox>
            <MenuBar>
                <Menu text="File">
                    <MenuItem text="Open Directory" fx:id="openDirectoryItem"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="New File (.ms)" fx:id="newFileItem"/>
                    <MenuItem text="New Folder" fx:id="newFolderItem"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Save" fx:id="saveItem"/>
                    <MenuItem text="Save All" fx:id="saveAllItem"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Exit"/>
                </Menu>
            </MenuBar>
            <HBox styleClass="tool-bar" alignment="CENTER_LEFT" spacing="10">
                <Separator orientation="VERTICAL"/>

                <Label text="Status:"/>
                <Label fx:id="statusLabel" text="Ready"/>

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="inspectorToggleButton"
                        id="symbolTableToggleButton"
                        text="⊞ Inspetor"
                        onAction="#toggleInspector"
                        style="-fx-cursor: hand;">
                    <tooltip>
                        <Tooltip text="Abrir/fechar painel de tokens e símbolos"/>
                    </tooltip>
                </Button>

                <Button fx:id="themeToggleButton"
                        id="themeToggleButton"
                        text="☀ Light Mode"
                        onAction="#toggleTheme"
                        style="-fx-cursor: hand;">
                    <tooltip>
                        <Tooltip text="Alternar entre modo escuro e claro"/>
                    </tooltip>
                </Button>

                <Label fx:id="autosaveLabel" text="Autosave: ON"/>
            </HBox>
        </VBox>
    </top>
    <left>
        <VBox prefWidth="250" style="-fx-border-color: #30363d; -fx-border-width: 0 1 0 0;">
            <Label text="PROJECT EXPLORER"
                   fx:id="projectExplorerLabel"
                   maxWidth="Infinity"
                   style="-fx-font-weight: bold; -fx-padding: 10 12 6 14; -fx-font-size: 11px;"/>
            <TreeView fx:id="projectTreeView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    <center>
        <TabPane fx:id="editorTabPane" tabClosingPolicy="ALL_TABS">
        </TabPane>
    </center>
    <right>
        <VBox fx:id="inspectorPanel" prefWidth="360" visible="false" managed="false"
              styleClass="symbol-table-panel">
            <HBox alignment="CENTER_LEFT" styleClass="symbol-panel-header">
                <Label text="INSPETOR" styleClass="symbol-panel-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#toggleInspector" styleClass="symbol-panel-close"/>
            </HBox>
            <TabPane fx:id="inspectorTabPane" tabClosingPolicy="UNAVAILABLE"
                     styleClass="inspector-tab-pane" VBox.vgrow="ALWAYS">
                <tabs>
                    <Tab text="Símbolos">
                        <TableView fx:id="symbolTableView">
                            <columns>
                                <TableColumn fx:id="symNameCol" text="Nome" prefWidth="85"/>
                                <TableColumn fx:id="symTypeCol" text="Tipo" prefWidth="60"/>
                                <TableColumn fx:id="symScopeCol" text="Escopo" prefWidth="50"/>
                                <TableColumn fx:id="symLineCol" text="Linha" prefWidth="42"/>
                                <TableColumn fx:id="symInitCol" text="Init" prefWidth="35"/>
                                <TableColumn fx:id="symUsedCol" text="Usado" prefWidth="45"/>
                            </columns>
                        </TableView>
                    </Tab>
                    <Tab text="Tokens">
                        <TableView fx:id="tokenTableView">
                            <columns>
                                <TableColumn fx:id="tokLexemeCol" text="Lexema" prefWidth="100"/>
                                <TableColumn fx:id="tokTypeCol" text="Tipo" prefWidth="110"/>
                                <TableColumn fx:id="tokLineCol" text="Linha" prefWidth="45"/>
                                <TableColumn fx:id="tokColCol" text="Col" prefWidth="40"/>
                            </columns>
                        </TableView>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </right>
    <bottom>
        <TabPane prefHeight="200" tabClosingPolicy="UNAVAILABLE"
                 styleClass="bottom-tab-pane">
            <tabs>
                <Tab text="Problems">
                    <BorderPane>
                        <center>
                            <TableView fx:id="problemsTable">
                                <columns>
                                    <TableColumn fx:id="lineColumn" text="Line" prefWidth="70"/>
                                    <TableColumn fx:id="columnColumn" text="Column" prefWidth="70"/>
                                    <TableColumn fx:id="messageColumn" text="Message" prefWidth="500"/>
                                </columns>
                            </TableView>
                        </center>
                    </BorderPane>
                </Tab>
                <Tab text="Terminal">
                    <TextArea fx:id="terminalArea"
                              id="terminalArea"
                              wrapText="true"
                              />
                </Tab>
            </tabs>
        </TabPane>
    </bottom>
</BorderPane>